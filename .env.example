LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

OPENCODE_API_KEY=oc_sk_...
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

GROQ_API_KEYS=gsk_...,gsk_...,gsk_...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...

MODEL_MAIN=opencode-go/deepseek-v4.1-flash
OPENCODE_REASONING_EFFORT=none
OPENCODE_RESPONSES_REASONING_EFFORT=minimal
# Groq gpt-oss accepts only low|medium|high (none -> HTTP 400); unset = medium
GROQ_REASONING_EFFORT=low
# single retry target for a reasoning-only reply (empty = MODEL_MAIN)
LLM_REASONING_FALLBACK_MODEL=
LLM_MAX_TOKENS=8192
MODEL_FAST=openai/gpt-oss-20b
MODEL_CLASSIFIER=openai/gpt-oss-safeguard-20b
MODEL_VISION=llama-3.2-11b-vision-preview

DEEPGRAM_API_KEY=your_deepgram_key
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-IN

ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=your_voice_id
ELEVENLABS_MODEL=eleven_multilingual_v2

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/math_tutor
SQLITE_FALLBACK_PATH=

LOGFIRE_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-math-tutor
LANGSMITH_TRACING=true

TURN_PLAN_DUAL_LANE=false
TURN_PLAN_PEER_GRACE_MS=3000
TURN_PLAN_LANE_TIMEOUT_S=25
SCENE_MAX_CANDIDATES=3
CLASSIFIER_TIMEOUT_S=3
DOUBT_SETTLE_TIMEOUT_MS=2500
SETTLE_CAP_MS=4000
INTERRUPT_MIN_WORDS=3
ALLOW_SUB3_INTERRUPT=false
HISTORY_EXCHANGES=3
STEP_BUDGET_PROBLEM=10
STREAM_IDLE_TIMEOUT_S=20
STREAM_TOTAL_TIMEOUT_S=90
IMAGE_MAX_EDGE_PX=1024
IMAGE_JPEG_QUALITY=80
TTS_SPEEDS=[0.8, 1.0, 1.2]

# Feature flags (all shipped features on; set a flag to false to disable it)
FEATURE_OUTBOX=true
FEATURE_PARKED_RESUME=true
FEATURE_CAPTIONS=true
MAX_PARKED_RUNS=2
MAX_CONCURRENT_PRODUCERS=2
OUTBOX_CAPACITY=256
OUTBOX_MAX_BYTES=4194304
CAPTION_WPS=2.6
SCENE_CANDIDATE_TIMEOUT_S=15
SCENE_JOIN_BUDGET_S=8
BOARD_PREP_LINE_AFTER_MS=4000
LEASE_TTL_S=30
LEASE_RENEW_S=10
LEASE_WAIT_S=3

FEATURE_MEMORY=true
FEATURE_REHYDRATE=true

FEATURE_PAGE_COMMIT=true

# Layout engine limits
MAX_BLOCKS_PER_PAGE=4
MIN_CELL_W=240
MIN_CELL_H=200
ASPECT_MIN=0.5
ASPECT_MAX=2.0
LAYOUT_PADDING=24
LAYOUT_GUTTER=24

FEATURE_CHAPTERS=true

# Chapter pipeline limits
MAX_CHAPTER_PAGES=6
PLANNER_BLOCK_BUDGET=2
MAX_STICKY_BLOCKS=2
STEP_BUDGET_PAGE_MIN=6
STEP_BUDGET_PAGE_MAX=10
STEP_BUDGET_PAGE_DEFAULT=8
OUTLINE_TIMEOUT_S=6
PAGE_GAP_MS=1200
