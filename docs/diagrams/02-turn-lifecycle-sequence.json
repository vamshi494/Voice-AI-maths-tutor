  "messages": [
    {
      "id": "msg_speech",
      "from": "student",
      "to": "livekit",
      "y": 170,
      "label": "Student voice audio stream",
      "variant": "default"
    },
    {
      "id": "msg_vad_turn",
      "from": "livekit",
      "to": "manager",
      "y": 210,
      "label": "VAD_START -> USER_TURN_DONE final transcript",
      "variant": "emphasis"
    },
    {
      "id": "msg_turn_req",
      "from": "manager",
      "to": "turn_plan",
      "y": 240,
      "label": "run_turn(TurnRequest, generation=G, kind='lesson')",
      "variant": "emphasis"
    },
    {
      "id": "msg_plan_solve",
      "from": "turn_plan",
      "to": "solve_lane",
      "y": 300,
      "label": "plan -> process_problem_ir_and_solve()",
      "variant": "default"
    },
    {
      "id": "msg_plan_scene",
      "from": "turn_plan",
      "to": "scene_lane",
      "y": 335,
      "label": "plan_and_compile_scene(join_budget=2.0s)",
      "variant": "emphasis",
      "note": "Dual-lane race: scene compiler runs concurrently with SymPy solver"
    },
    {
      "id": "msg_solve_done",
      "from": "solve_lane",
      "to": "authority",
      "y": 375,
      "label": "solver_projection & contradiction audit",
      "variant": "default"
    },
    {
      "id": "msg_scene_done",
      "from": "scene_lane",
      "to": "authority",
      "y": 410,
      "label": "VerifiedDiagram & visual_status ('validated')",
      "variant": "default"
    },
    {
      "id": "msg_reconciled",
      "from": "authority",
      "to": "teaching",
      "y": 445,
      "label": "reconciled plan + solver number overrides",
      "variant": "emphasis"
    },
    {
      "id": "msg_send_step_evt",
      "from": "teaching",
      "to": "sync",
      "y": 505,
      "label": "send_event(StepEvt / DiagramCommit)",
      "variant": "emphasis",
      "note": "Visual-first rule: board ops sent on tutor.events BEFORE matching TTS speech begins"
    },
    {
      "id": "msg_say_tts",
      "from": "teaching",
      "to": "livekit",
      "y": 545,
      "label": "session.say(tts_text consumer stream)",
      "variant": "default",
      "note": "Staleness guard: aborts if run cancelled or state.generation != req.generation"
    },
    {
      "id": "msg_audio_words",
      "from": "livekit",
      "to": "sync",
      "y": 585,
      "label": "WebRTC audio track + transcript words (lk.transcription)",
      "variant": "default"
    },
    {
      "id": "msg_fire_op",
      "from": "sync",
      "to": "executor",
      "y": 650,
      "label": "onFireOp(BoardOp, generation, turnId)",
      "variant": "emphasis",
      "note": "Word matcher paces step ops with msPerWord EMA"
    },
    {
      "id": "msg_step_ack",
      "from": "executor",
      "to": "manager",
      "y": 695,
      "label": "step_ack / step_progress on tutor.report",
      "variant": "return",
      "note": "Manager updates last_acked_step_index and server PageLedger"
    }
  ],
