  "cards": [
    {
      "dot": "cyan",
      "title": "Speech & Ingestion",
      "items": [
        "LiveKit VAD detects user speech; Deepgram nova-2 emits final transcript",
        "StateMachineManager serializes event handling under an asyncio.Lock",
        "Fast-path classifier resolves user turn into ConvEvent.CLS_NEW_QUESTION"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dual-Lane LangGraph",
      "items": [
        "turn_plan node launches problem_ir_and_solve and plan_and_compile_scene in parallel",
        "SymPy solver generates deterministic algebraic projections and contradiction audits",
        "reconcile_authority injects solver overrides before stream_teaching_turn runs"
      ]
    },
    {
      "dot": "amber",
      "title": "Visual-First Synchronization",
      "items": [
        "StepEvt & DiagramCommit are published before matching TTS audio streams",
        "Generation guard aborts turn generation if an interrupt bumps state generation",
        "TranscriptSyncMatcher aligns spoken words to board ops and reports progress to server"
      ]
    }
  ]
