  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Frontend Whiteboard",
      "items": [
        "React 18 whiteboard powered by Konva multi-layer chalkboard rendering",
        "TranscriptSyncMatcher synchronizes spoken words with visual step animations",
        "Client sends step_progress and step_ack reports over tutor.report topic"
      ]
    },
    {
      "dot": "emerald",
      "title": "Realtime Pipeline",
      "items": [
        "LiveKit SFU brokers real-time audio and RPC dispatch with low latency",
        "Dual transport splits events at 14 KiB between publish_data packets and send_text streams",
        "StateMachineManager serializes state transitions under an asyncio lock"
      ]
    },
    {
      "dot": "amber",
      "title": "Resilient Providers",
      "items": [
        "Deepgram nova-2 streaming STT with VAD barge-in guard (minimum 3 words)",
        "ElevenLabs primary TTS backed by Deepgram fallback adapter",
        "LLM gateway fails over Groq -> OpenRouter -> OpenCode Zen; DB fails over Postgres -> SQLite WAL"
      ]
    }
  ]
}
