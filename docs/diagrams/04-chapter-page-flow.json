  "cards": [
    {
      "dot": "cyan",
      "title": "Chapter Architecture",
      "items": [
        "Outline node synthesizes LessonPlan with stable sticky-block IDs",
        "Page 1 starts immediately while outline background task completes",
        "Sticky scenes are cached across chapter pages to prevent re-generation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Prefetch & Gap",
      "items": [
        "maybe_prefetch starts page N+1 into a parked PageRun stream during page N speech",
        "Page gap sleep runs outside StateMachineManager lock so interrupts are unblocked",
        "Filler aside keeps student engaged if prefetched producer is still running"
      ]
    },
    {
      "dot": "amber",
      "title": "Interruption & Recovery",
      "items": [
        "Doubt during gap cancels timer task but preserves advance_pending flag",
        "Doubt resolution seamlessly re-spawns advance for the intended target page",
        "Carried stickies inject previous compiled scenes with revealed ledger history"
      ]
    }
  ]
